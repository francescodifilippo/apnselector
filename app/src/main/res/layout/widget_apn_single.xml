<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_single_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_single_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/single_icon"
        android:layout_width="@dimen/widget_single_icon_size"
        android:layout_height="@dimen/widget_single_icon_size"
        android:contentDescription="@string/active"
        android:src="@drawable/ic_check_white" />

    <TextView
        android:id="@+id/single_apn_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_on_color"
        android:textSize="@dimen/widget_single_text_size" />

</LinearLayout>
